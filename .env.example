# Database
DATABASE_URL=mysql://user:password@localhost:3306/ecclesia

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v2

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# App
APP_NAME=Ecclesia
APP_VERSION=2.0.0
