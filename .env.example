# Database
DATABASE_URL=mysql://user:password@localhost:3306/ecclesia

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v2

# JWT
# Production refuses to start unless this is unique and at least 32 characters
JWT_SECRET=your-secret-key-change-in-production
# Optional separate key for encrypting 2FA secrets at rest (defaults to a hash of JWT_SECRET)
TWO_FACTOR_ENCRYPTION_KEY=
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# App
APP_NAME=Ecclesia
APP_VERSION=2.0.0

# Email (leave SMTP_HOST empty in development to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ecclesia <no-reply@example.com>
APP_URL=http://localhost:5173

# Set to the number of reverse proxies in front of the API so rate limits use real client IPs
TRUST_PROXY=

# Payments (Paynow). Leave empty in development to use the simulated gateway.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Public URL Paynow calls when a payment changes status (defaults to API_URL + /api/v2/payments/webhook/paynow)
PAYNOW_RESULT_URL=
# Where Paynow sends the member's browser afterwards (defaults to APP_URL + /give/confirm)
PAYNOW_RETURN_URL=
API_URL=http://localhost:3000
# Currency the Paynow merchant account settles in
PAYMENT_CURRENCY=USD
