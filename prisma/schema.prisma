  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  name         String
  targetAmount Decimal
  currency     String   @default("USD")
  status       String   @default("ACTIVE") // ACTIVE, FULFILLED, CANCELLED
  startDate    DateTime @default(now())
  endDate      DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([churchId])
  @@index([memberId])
  @@index([fundId])
}

model RecurringGiving {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  amount     Decimal
  currency   String   @default("USD")
  incomeType String   @default("OFFERING")
  frequency  String // WEEKLY, MONTHLY
  method     String // ECOCASH, ONEMONEY
  phone      String

  nextChargeDate DateTime
  isActive       Boolean  @default(true)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([churchId])
  @@index([memberId])
  @@index([fundId])
  @@index([isActive, nextChargeDate])
}


model NotificationPreference {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  channel  String // IN_APP, EMAIL, SMS, PUSH
  category String // GIVING, EVENTS, ANNOUNCEMENTS, PASTORAL
  enabled  Boolean

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([memberId, channel, category])
  @@index([memberId])
}

model PushSubscription {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  endpoint  String  @unique @db.VarChar(500)
  p256dh    String  @db.VarChar(255)
  authKey   String  @db.VarChar(255)
  userAgent String?

  createdAt DateTime @default(now())

  @@index([memberId])
}

model CommunicationTemplate {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name    String
  subject String
  body    String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
}

model BroadcastMessage {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  senderId String // user id
  title    String
  body     String @db.Text
  category String @default("ANNOUNCEMENTS")
  audience String @db.Text // JSON: {"type":"ALL"|"SECTIONS"|"ORGANIZATIONS","ids":[...]}
  channels String // comma separated: IN_APP,EMAIL,SMS

  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED, CANCELLED
  scheduledAt DateTime?
  sentAt      DateTime?

  recipientCount Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([churchId])
  @@index([status, scheduledAt])
}

model NotificationDelivery {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  broadcastId String?
  memberId    String
  channel     String // EMAIL, SMS, PUSH
  category    String
  status      String // SENT, FAILED, SKIPPED
  reason      String?

  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([broadcastId])
  @@index([memberId])
}


model MemberImport {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  fileName  String
  createdBy String // user id
  status    String // COMPLETED, PARTIAL, FAILED
  totalRows Int
  imported  Int
  skipped   Int
  errorLog  String? @db.Text // JSON: [{row, message}]

  createdAt DateTime @default(now())

  @@index([churchId])
}

model Visitor {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?
  email     String?
  visitDate DateTime @default(now())
  source    String? // how they heard of the church
  notes     String?  @db.Text

  followUpStatus    String  @default("NEW") // NEW, CONTACTED, SCHEDULED, JOINED, NOT_INTERESTED
  assignedToId      String? // member id of the person following up
  convertedMemberId String? @unique

  followUps VisitorFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([churchId])
  @@index([churchId, followUpStatus])
  @@index([assignedToId])
}

model VisitorFollowUp {
  id        String  @id @default(cuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  churchId  String

  actorId String // user id
  method  String // CALL, VISIT, MESSAGE, OTHER
  notes   String? @db.Text

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([churchId])
}

model CommitteeMeeting {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  title       String
  scheduledAt DateTime
  location    String?
  agenda      String?  @db.Text
  minutes     String?  @db.Text
  status      String   @default("SCHEDULED") // SCHEDULED, HELD, CANCELLED

  // Once set, the minutes are the permanent record and can no longer be edited
  minutesLockedAt DateTime?
  createdBy       String

  decisions CommitteeDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([churchId])
  @@index([committeeId])
  @@index([scheduledAt])
}

model CommitteeDecision {
  id        String           @id @default(cuid())
  meetingId String
  meeting   CommitteeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  churchId  String

  description  String   @db.Text
  status       String   @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, DEFERRED
  votesFor     Int      @default(0)
  votesAgainst Int      @default(0)
  abstentions  Int      @default(0)
  ownerMemberId String?
  dueDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([meetingId])
  @@index([churchId])
}

model LeadershipTerm {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   LeadershipAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  termNumber     Int
  startDate      DateTime
  plannedEndDate DateTime?
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, TERMINATED
  successorId    String? // member id
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([assignmentId, termNumber])
  @@index([churchId])
  @@index([status, plannedEndDate])
}


model LedgerAccount {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  code        String
  name        String
  type        String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  description String?
  parentId    String?
  parent      LedgerAccount?  @relation("LedgerAccountTree", fields: [parentId], references: [id])
  children    LedgerAccount[] @relation("LedgerAccountTree")
  isActive    Boolean         @default(true)
  isSystem    Boolean         @default(false)

  lines       JournalLine[]
  budgetItems BudgetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([churchId, code])
  @@index([churchId])
  @@index([parentId])
}

model FinancialPeriod {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  status    String    @default("OPEN") // OPEN, CLOSED
  closedAt  DateTime?
  closedBy  String?

  entries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([churchId, name])
  @@index([churchId, startDate, endDate])
}

model JournalEntry {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  reference   String
  description String
  postDate    DateTime
  periodId    String?
  period      FinancialPeriod? @relation(fields: [periodId], references: [id])

  status         String  @default("DRAFT") // DRAFT, POSTED, REVERSED
  source         String  @default("MANUAL") // MANUAL, RECEIPT, EXPENDITURE, OPENING, REVERSAL
  sourceId       String?
  reversesEntryId String? @unique
  reversalReason String?

  createdBy String // user id
  postedBy  String? // user id
  postedAt  DateTime?

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([churchId, reference])
  @@unique([churchId, source, sourceId])
  @@index([churchId, status])
  @@index([periodId])
  @@index([postDate])
}

model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)
  memo   String?
  fundId String?

  @@index([entryId])
  @@index([accountId])
  @@index([fundId])
}

model Budget {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name       String
  fiscalYear Int
  status     String    @default("DRAFT") // DRAFT, APPROVED, CLOSED
  createdBy  String
  approvedBy String?
  approvedAt DateTime?

  items BudgetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([churchId, name, fiscalYear])
  @@index([churchId, fiscalYear])
}

model BudgetItem {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  fundId    String?
  amount    Decimal       @db.Decimal(14, 2)

  @@index([budgetId])
  @@index([accountId])
}
