// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY & AUTHENTICATION
// ============================================================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  memberId                         String?                  @unique
  member                           Member?                  @relation("UserMember", fields: [memberId], references: [id])
  churchId                         String?
  requestedMembershipStatusChanges MembershipStatusChange[] @relation("MembershipRequestedBy")
  approvedMembershipStatusChanges  MembershipStatusChange[] @relation("MembershipApprovedBy")

  emailVerified Boolean @default(false)

  sessions           Session[]
  devices            Device[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  twoFactorSecret    TwoFactorSecret?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Invitation {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  email     String
  memberId  String?
  invitedBy String

  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([churchId])
  @@index([email])
}

model TwoFactorSecret {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secretEncrypted  String
  isEnabled        Boolean @default(false)
  backupCodeHashes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([deviceId])
}

model Device {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())

  sessions Session[]

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// ORGANIZATION STRUCTURE
// ============================================================================

model Conference {
  id        String     @id @default(cuid())
  name      String
  code      String?    @unique
  districts District[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model District {
  id           String      @id @default(cuid())
  conferenceId String?
  conference   Conference? @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  name         String
  code         String?
  circuits     Circuit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conferenceId, name])
  @@index([conferenceId])
}

model Circuit {
  id         String    @id @default(cuid())
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  name       String
  churches   Church[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

model Church {
  id        String   @id @default(cuid())
  circuitId String?
  circuit   Circuit? @relation(fields: [circuitId], references: [id])

  name     String
  location String?

  // Organization hierarchy
  sections      Section[]
  families      Family[]
  members       Member[]
  organizations Organization[]
  committees    Committee[]

  // Events
  events Event[]

  // Finance
  financialAccount FinancialAccount?
  funds            Fund[]
  receipts         Receipt[]
  expenditures     Expenditure[]
  cashSessions     CashSession[]

  // Leadership
  roles                 Role[]
  leadershipAssignments LeadershipAssignment[]

  // Pastoral
  pastoralCases               PastoralCase[]
  pastoralVisits              PastoralVisit[]
  counselingSessions          CounselingSession[]
  pastoralReferrals           PastoralReferral[]
  pastoralFollowUps           PastoralFollowUp[]
  pastoralAssessments         PastoralAssessment[]
  prayerRequests              PrayerRequest[]
  lifeEvents                  LifeEvent[]
  spiritualDevelopmentRecords SpiritualDevelopmentRecord[]
  baptismRecords              BaptismRecord[]
  confirmationRecords         ConfirmationRecord[]
  marriageRecords             MarriageRecord[]
  funeralRecords              FuneralRecord[]
  pastoralNotifications       PastoralNotification[]

  // Audit
  auditLogs   AuditLog[]
  invitations Invitation[]

  // Accounting
  ledgerAccounts   LedgerAccount[]
  financialPeriods FinancialPeriod[]
  journalEntries   JournalEntry[]
  budgets          Budget[]

  // People & governance
  visitors          Visitor[]
  memberImports     MemberImport[]
  committeeMeetings CommitteeMeeting[]
  leadershipTerms   LeadershipTerm[]

  // Notifications
  broadcastMessages      BroadcastMessage[]
  communicationTemplates CommunicationTemplate[]
  notificationDeliveries NotificationDelivery[]

  // Payments
  payments        Payment[]
  pledges         Pledge[]
  recurringGiving RecurringGiving[]

  // Events
  eventRegistrations EventRegistration[]
  eventCheckIns      EventCheckIn[]
  volunteerSchedules VolunteerSchedule[]
  absenceFollowUps   AbsenceFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circuitId])
}

model Section {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?

  members  Member[]
  families Family[]
  events   Event[]

  // Section Finance (isolated)
  financialAccount SectionFinancialAccount?
  receipts         SectionReceipt[]
  expenditures     SectionExpenditure[]
  transactions     SectionTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
}

model Family {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  name           String
  description    String?
  headOfFamilyId String?

  members       Member[]
  relationships FamilyRelationship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId])
  @@index([sectionId])
}

model Member {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  // Identity
  firstName   String
  middleName  String?
  lastName    String
  email       String?
  phone       String?
  gender      String?
  dateOfBirth DateTime?

  // Membership
  membershipNumber String   @unique
  membershipStatus String   @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED, DECEASED
  joinDate         DateTime @default(now())
  membershipDate   DateTime @default(now())
  address          String?

  // Family relationships
  isDependent    Boolean  @default(false)
  parentId       String?
  parent         Member?  @relation("DependentRelationships", fields: [parentId], references: [id])
  dependents     Member[] @relation("DependentRelationships")
  parentMemberId String?
  parentMember   Member?  @relation("MemberParent", fields: [parentMemberId], references: [id])
  childMembers   Member[] @relation("MemberParent")

  // Personal info
  maritalStatus String? // SINGLE, MARRIED, DIVORCED, WIDOWED

  // Archiving hides a member from directories and mailings without deleting history
  archivedAt DateTime?
  archivedBy String?

  // Authentication
  user                    User?                    @relation("UserMember")
  familyRelationships     FamilyRelationship[]     @relation("FamilyMember")
  membershipStatusChanges MembershipStatusChange[]

  // Leadership & Permissions
  leadershipAssignments LeadershipAssignment[]
  organizationRoles     OrganizationRoleAssignment[]

  // Family relationships
  asPartner1 FamilyRelationship[] @relation("Partner1")
  asPartner2 FamilyRelationship[] @relation("Partner2")
  asParent   FamilyRelationship[] @relation("Parent")
  asChild    FamilyRelationship[] @relation("Child")

  // Organization membership
  organizationMemberships OrganizationMembership[]

  // Events & Attendance
  eventAttendances EventAttendance[]
  eventRegistrations EventRegistration[]
  eventCheckIns      EventCheckIn[]
  volunteerSchedules VolunteerSchedule[]
  absenceFollowUps   AbsenceFollowUp[]

  // Finance
  receipts     Receipt[]
  expenditures Expenditure[]

  // Section Finance
  sectionReceipts SectionReceipt[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  payments            Payment[]
  pledges             Pledge[]
  recurringGiving     RecurringGiving[]
  savedPaymentMethods SavedPaymentMethod[]

  // Pastoral Care
  pastoralCases               PastoralCase[]               @relation("PastoralCaseMember")
  assignedCases               PastoralCase[]               @relation("PastoralCaseAssignedPastor")
  pastoralVisits              PastoralVisit[]
  counselingSessions          CounselingSession[]
  pastoralReferrals           PastoralReferral[]
  pastoralFollowUps           PastoralFollowUp[]
  pastoralAssessments         PastoralAssessment[]
  prayerRequests              PrayerRequest[]
  lifeEvents                  LifeEvent[]
  spiritualDevelopmentRecords SpiritualDevelopmentRecord[]
  baptismRecords              BaptismRecord[]
  confirmationRecords         ConfirmationRecord[]
  marriageRecordsP1           MarriageRecord[]             @relation("MarriageRecordPartner1")
  marriageRecordsP2           MarriageRecord[]             @relation("MarriageRecordPartner2")
  funeralRecords              FuneralRecord[]

  // Audit
  lastPastoralContactAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  EventParticipant      EventParticipant[]

  @@unique([churchId, email])
  @@index([churchId])
  @@index([sectionId])
  @@index([familyId])
  @@index([membershipStatus])
  @@index([archivedAt])
  @@index([parentId])
  @@index([parentMemberId])
}

model FamilyRelationship {
  id String @id @default(cuid())

  partner1Id String?
  partner1   Member? @relation("Partner1", fields: [partner1Id], references: [id])

  partner2Id String?
  partner2   Member? @relation("Partner2", fields: [partner2Id], references: [id])

  parentId String?
  parent   Member? @relation("Parent", fields: [parentId], references: [id])

  childId String?
  child   Member? @relation("Child", fields: [childId], references: [id])

  relationshipType String // SPOUSE, CHILD, PARENT, SIBLING

  memberId String?
  member   Member? @relation("FamilyMember", fields: [memberId], references: [id])

  createdAt DateTime @default(now())
  Family    Family?  @relation(fields: [familyId], references: [id])
  familyId  String?
  updatedAt DateTime @default(now()) @updatedAt

  @@index([partner1Id])
  @@index([partner2Id])
  @@index([parentId])
  @@index([childId])
  @@index([memberId])
  @@index([familyId])
}

// ============================================================================
// ORGANIZATIONS (Fellowships, Groups)
// ============================================================================

model Organization {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name             String // MUMC, RRW, UMYF, Children's Ministries, etc.
  shortName        String
  organizationType String
  status           String  @default("ACTIVE")
  description      String?

  members          OrganizationMembership[]
  roles            OrganizationRoleAssignment[]
  events           Event[]
  financialAccount OrganizationFinancialAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  joinedAt         DateTime  @default(now())
  endedAt          DateTime?
  membershipStatus String    @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED
  notes            String?   @db.Text

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([organizationId, memberId])
  @@index([organizationId])
  @@index([memberId])
}

model OrganizationRoleAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  position  String // President, Treasurer, Secretary, etc.
  startDate DateTime  @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([organizationId, memberId, position])
  @@index([organizationId])
  @@index([memberId])
}

model Committee {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name        String
  description String?

  members  LeadershipAssignment[]
  meetings CommitteeMeeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId])
}

// ============================================================================
// LEADERSHIP & PERMISSIONS
// ============================================================================

model Role {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name        String // Pastor, Treasurer, Section Leader, etc.
  description String?

  permissions RolePermission[]
  assignments LeadershipAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
}

model Permission {
  id String @id @default(cuid())

  name        String  @unique // member:view, pastoral:case:create, etc.
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model LeadershipAssignment {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id])
  sectionId   String?

  position  String? // Specific title within role
  startDate DateTime  @default(now())
  endDate   DateTime?
  terms     LeadershipTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId])
  @@index([memberId])
  @@index([roleId])
  @@index([committeeId])
}

// ============================================================================
// EVENTS & ATTENDANCE
// ============================================================================

model Event {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  title       String
  description String?

  eventType String // SERVICE, BIBLE_STUDY, PRAYER, WEDDING, BAPTISM, FUNERAL, etc.

  startDateTime DateTime
  endDateTime   DateTime?
  location      String?

  status             String @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  expectedAttendance Int?

  capacity             Int?
  registrationRequired Boolean @default(false)

  attendances        EventAttendance[]
  participants       EventParticipant[]
  registrations      EventRegistration[]
  checkIns           EventCheckIn[]
  volunteerSchedules VolunteerSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId])
  @@index([sectionId])
  @@index([organizationId])
  @@index([startDateTime])
}

model EventAttendance {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status    String // PRESENT, ABSENT, EXCUSED, UNCONFIRMED
  arrivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  role String? // Preacher, Usher, Musician, etc.

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model EventRegistration {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // A member registers themselves; a guest has no member record, only contact details.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  status       String   @default("REGISTERED") // REGISTERED, CANCELLED
  registeredBy String // user or member id that made the registration
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])
  @@index([churchId])
  @@index([eventId, status])
  @@index([memberId])
}

model EventCheckIn {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  method      String // QR, MANUAL, KIOSK
  checkedInBy String // user or member id that performed the check-in
  checkedInAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@index([churchId])
  @@index([eventId])
  @@index([memberId])
}

model VolunteerSchedule {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  role   String
  status String  @default("ASSIGNED") // ASSIGNED, CONFIRMED, DECLINED, COMPLETED, NO_SHOW, CANCELLED
  notes  String? @db.Text

  assignedBy  String
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId, role])
  @@index([churchId])
  @@index([eventId])
  @@index([memberId, status])
}

model AbsenceFollowUp {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  consecutiveAbsences Int
  eventType           String

  status     String  @default("OPEN") // OPEN, CONTACTED, RESOLVED, DISMISSED
  // "OPEN" while the follow-up is live, NULL once closed: the unique index then allows one live follow-up per member.
  openKey    String? @default("OPEN")
  assignedTo String?
  notes      String? @db.Text

  detectedAt DateTime  @default(now())
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, memberId, openKey])
  @@index([churchId, status])
  @@index([assignedTo])
}

// ============================================================================
// FINANCE - MAIN CHURCH LEDGER
// ============================================================================

model FinancialAccount {
  id       String @id @default(cuid())
  churchId String @unique
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  openingBalance Decimal @default(0)
  currentBalance Decimal @default(0)
  type           String  @default("OPERATING")
  status         String  @default("ACTIVE") // ACTIVE, INACTIVE

  funds        Fund[]
  receipts     Receipt[]
  expenditures Expenditure[]
  cashSessions CashSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fund {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name        String // Building Fund, Missions, General, etc.
  description String?
  balance     Decimal @default(0)
  isActive    Boolean @default(true)
  // Restricted funds may only be spent on their stated purpose
  isRestricted Boolean @default(false)

  receipts     Receipt[]
  expenditures Expenditure[]
  payments     Payment[]
  pledges      Pledge[]
  recurring    RecurringGiving[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, name])
  @@index([churchId])
  @@index([accountId])
}

model Receipt {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  memberId       String?
  member         Member? @relation(fields: [memberId], references: [id])
  organizationId String?

  amount        Decimal
  currency      String  @default("USD")
  incomeType    String // OFFERING, TITHE, DONATION, FUNDRAISING
  paymentMethod String // CASH, BANK_TRANSFER, MOBILE_MONEY, CHEQUE

  receiptNumber String @unique
  status        String @default("ISSUED") // ISSUED, VOIDED, REVERSED

  recordedAt DateTime @default(now())
  issuedAt   DateTime @default(now())
  recordedBy String? // Member ID of recorder

  createdAt          DateTime          @default(now())
  FinancialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  financialAccountId String?

  updatedAt DateTime @default(now()) @updatedAt
  payment   Payment?

  @@index([churchId])
  @@index([fundId])
  @@index([memberId])
  @@index([financialAccountId])
}

model Expenditure {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  requestedBy       String
  requestedByMember Member? @relation(fields: [requestedBy], references: [id])
  organizationId    String?

  amount   Decimal
  purpose  String
  category String // Administrative, Building, Salaries, etc.

  status     String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, PAID
  approvedBy String?
  approvedAt DateTime?

  paidAt      DateTime?
  requestedAt DateTime  @default(now())

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  FinancialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  financialAccountId String?

  @@index([churchId])
  @@index([fundId])
  @@index([requestedBy])
  @@index([financialAccountId])
}

model CashSession {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  openingBalance Decimal
  closingBalance Decimal?
  status         String   @default("OPEN") // OPEN, CLOSED
  closedAt       DateTime?
  closedBy       String? // user id
  cashPaidOut    Decimal?
  expectedClosing Decimal?
  variance       Decimal?
  notes          String?  @db.Text

  handledBy   String // Member ID
  sessionDate DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

